.pusher-container {
  background: #000;
  display: block;
  position: absolute;
  overflow: hidden;
}

.pusher {
  height: 100%;
  position: absolute;
  width: 100%;
  top: 0;
  left: 0;
}

.sud {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(27, 42, 56, 0.65);
}

.sud-text {
  color: #fff;
  font-size: 28rpx;
}
