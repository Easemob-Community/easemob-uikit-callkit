{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["@dcloudio/types"]
  },
  "include": [
    "./**/*.ts",
    "./**/*.vue",
    "./uni_modules/em-callkit-weixin/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "unpackage",
    "dist"
  ]
}
