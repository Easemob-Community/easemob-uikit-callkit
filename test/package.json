{
  "name": "@easemob-community/callkit-vue3-test",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run dev:source",
    "dev:source": "vite --config vite.config.source.ts",
    "dev:tgz": "vite --config vite.config.tgz.ts",
    "switch:source": "node scripts/switch-mode.mjs source && pnpm install",
    "switch:tgz": "node scripts/switch-mode.mjs tgz && pnpm add file:../release/easemob-community-callkit-vue3-2.0.1.tgz",
    "build": "vue-tsc -b && vite build --config vite.config.source.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "agora-rtc-sdk-ng": "^4.24.2",
    "easemob-websdk": "^4.16.0",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.7.0",
    "pinia": "^2.3.1",
    "typescript": "~5.8.3",
    "vite": "^7.1.2",
    "vue-tsc": "^3.0.5"
  }
}
