{
  "name": "easemob-uikit-callkit-workspace",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Easemob UIKit CallKit monorepo workspace",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:lib": "pnpm --filter @easemob-community/callkit-vue3 build",
    "build:core": "pnpm --filter @easemob-community/callkit-core build",
    "build:all": "pnpm build:core && pnpm build:lib",
    "build:pack": "pnpm --filter @easemob-community/callkit-vue3 build:pack",
    "preview": "vite preview",
    "test": "pnpm run test:source",
    "test:source": "cd test && pnpm run switch:source && pnpm run dev:source",
    "test:tgz": "pnpm run build:pack && cd test && pnpm run switch:tgz && pnpm run dev:tgz",
    "typecheck": "vue-tsc --noEmit --skipLibCheck"
  },
  "devDependencies": {
    "@easemob-community/callkit-core": "workspace:*",
    "@easemob-community/callkit-vue3": "workspace:*",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.7.0",
    "agora-rtc-sdk-ng": "^4.24.2",
    "easemob-websdk": "^4.16.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.2",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.18",
    "vue-tsc": "^3.0.5"
  },
  "license": "MIT",
  "author": "Easemob",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Easemob-Community/easemob-uikit-callkit.git"
  },
  "bugs": {
    "url": "https://github.com/Easemob-Community/easemob-uikit-callkit/issues"
  },
  "homepage": "https://github.com/Easemob-Community/easemob-uikit-callkit#readme",
  "keywords": [
    "easemob",
    "chat",
    "callkit",
    "vue3",
    "webrtc",
    "agora",
    "video-call",
    "audio-call",
    "group-call"
  ],
  "packageManager": "pnpm@10.10.0"
}
